# VLC Control - system config
# Installed to: ~/.config/vlc-control/config.env
#
# Notes:
# - TOKEN is generated fresh on every run.
# - VLC_PASS can be generated during install (you can change it, but VLC must match).

# Web bridge listens here (local):
PORT=5000

# Max "seats" (unique browsers / client_ids)
MAX_CLIENTS=2

# Seat reservation after a client disconnects (anti-sniper)
GRACE_SECONDS=30

# VLC HTTP interface
VLC_HOST=127.0.0.1
VLC_PORT=8080

# VLC HTTP password
VLC_PASS=

# VLC launch mode: auto | flatpak | native | none
VLC_MODE=auto

# Auto-start VLC if HTTP isn't reachable: yes | no
START_VLC=yes

# Cloudflare behavior: auto | on | off
CLOUDFLARE=on

# Directory for log and pid files
LOG_DIR=/tmp
