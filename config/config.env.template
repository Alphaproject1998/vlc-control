# VLC Control - system config
# Installed to: ~/.config/vlc-control/config.env
#
# Notes:
# - TOKEN is generated fresh on every run.
# - VLC_PASS can be generated during install (you can change it, but VLC must match).

# Web bridge listens here (local):
PORT=5000

# Max "seats" (unique browsers / client_ids)
MAX_CLIENTS=2

# Seat reservation after a client disconnects (anti-sniper)
GRACE_SECONDS=30

# VLC HTTP interface
VLC_HOST=127.0.0.1
VLC_PORT=8080

# VLC HTTP password
VLC_PASS=

# VLC launch mode: auto | flatpak | native | none
VLC_MODE=auto

# Auto-start VLC if HTTP isn't reachable: yes | no
START_VLC=yes

# Cloudflare behavior: auto | on | off
CLOUDFLARE=on

# Directory for log and pid files
LOG_DIR=/tmp

# File browser system, master switch: off | on
FILE_BROWSE=on

# Auto-expose the directory of the currently playing file: yes | no
FILE_BROWSE_AUTO=yes

# Allow browsing subdirectories of the auto-exposed folder: yes | no
# Default no (flat - files only). Set yes for recursive navigation.
FILE_BROWSE_AUTO_RECURSIVE=no

# Allowed root directories, colon-separated
# Append /* to a path to allow browsing its subdirectories; default is files only.
# Example: FILE_BROWSE_DIRS=/mnt/media/movies:/mnt/media/shows/*
FILE_BROWSE_DIRS=

# Allowed file extensions, comma-separated
FILE_BROWSE_EXTENSIONS=mp4,mkv,avi,mov,webm,mp3,ogg,m4a,wav

# Hide directories whose path (relative to a root) ends in/contains these segments.
# Colon-separated, case-insensitive, matched on path components. A multi-segment
# entry like "comp/vids" matches that sequence anywhere under a root.
# Example: FILE_BROWSE_BLACKLIST_DIRS=secret:comp/vids:private
FILE_BROWSE_BLACKLIST_DIRS=

# Hide any file or directory whose name contains one of these substrings.
# Comma-separated, case-insensitive.
# Example: FILE_BROWSE_BLACKLIST_TERMS=nsfw,_hidden
FILE_BROWSE_BLACKLIST_TERMS=
