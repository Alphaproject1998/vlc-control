#!/usr/bin/env bash
set -euo pipefail

: <<'DOC'
vlc-control runner

Starts the Python bridge and optionally a Cloudflare quick tunnel.
Reads config from ~/.config/vlc-control/config.toml (or XDG overrides).
DOC

export PATH="$HOME/.local/bin:/usr/local/bin:/usr/bin:/bin${PATH:+:$PATH}"
PREFIX="${VLC_CONTROL_PREFIX:-${XDG_DATA_HOME:-$HOME/.local/share}/vlc-control}"

APP_VERSION="$(sed -n 's/^VERSION = "\([^"]*\)".*/\1/p' "$PREFIX/vlc-bridge.py" 2>/dev/null | head -n 1)"
[[ -n "$APP_VERSION" ]] || APP_VERSION="unknown"

show_help() {
  cat <<H
vlc-control ${APP_VERSION}

Usage: vlc-control [--seats N|-s N]

Runs the local bridge + (optional) Cloudflare quick tunnel.

Options:
  -s, --seats N   Override max seats (clients) for this run only
  -v, --version   Print the version and exit
  -h, --help      Show this help
H
}

show_version() {
  cat <<H
vlc-control ${APP_VERSION}
H
}

_read_system_config() {
  python3 - "$1" <<'PY'
import sys
try:
    import tomllib
except ImportError:
    try:
        import tomli as tomllib
    except ImportError:
        print("ERROR: tomllib unavailable. Python 3.11+ required, or install tomli.", file=sys.stderr)
        sys.exit(1)
import shlex

with open(sys.argv[1], "rb") as f:
    c = tomllib.load(f)

s = c.get("system", {})
fields = [
    ("PORT", str(s.get("port", 5000))),
    ("MAX_CLIENTS", str(s.get("max_clients", 2))),
    ("GRACE_SECONDS", str(s.get("grace_seconds", 30))),
    ("VLC_HOST", str(s.get("vlc_host", "127.0.0.1"))),
    ("VLC_PORT", str(s.get("vlc_port", 8080))),
    ("VLC_PASS", str(s.get("vlc_pass", ""))),
    ("VLC_MODE", str(s.get("vlc_mode", "auto"))),
    ("START_VLC", "yes" if s.get("start_vlc", True) else "no"),
    ("KILL_VLC_ON_EXIT", "yes" if s.get("kill_vlc_on_exit", True) else "no"),
    ("CLOUDFLARE", str(s.get("cloudflare", "auto"))),
    ("LOG_DIR", str(s.get("log_dir", "/tmp"))),
    ("STATUS_SHOW", ",".join(str(i) for i in c.get("status", {}).get("show", []))),
]
for k, v in fields:
    print(f"{k}={shlex.quote(v)}")
PY
}

_read_install_state() {
  python3 - "$1" "$2" <<'PY'
import json, os, shlex, sys, pathlib
from datetime import datetime

state_path = pathlib.Path(sys.argv[1])
fallback_version = sys.argv[2]

try:
    state = json.loads(state_path.read_text(encoding="utf-8"))
except (OSError, ValueError):
    state = {}

def ago(then):
    seconds = (datetime.now().astimezone() - then).total_seconds()
    if seconds < 60:
        return "just now"
    for size, unit in ((31536000, "year"), (86400, "day"), (3600, "hour"), (60, "minute")):
        if seconds >= size:
            count = int(seconds // size)
            return f"{count} {unit}{'s' if count != 1 else ''} ago"
    return "just now"

def pretty(value):
    if not value:
        return ""
    try:
        when = datetime.fromisoformat(value)
    except ValueError:
        return ""
    return f"{when.strftime('%d %b %Y, %H:%M')} ({ago(when)})"

def newest_source_mtime(root):
    newest = 0.0
    for name in ("backend", "static", "scripts", "config"):
        directory = root / name
        if not directory.is_dir():
            continue
        for path in directory.rglob("*"):
            if path.is_file():
                newest = max(newest, path.stat().st_mtime)
    for name in ("install.sh", "requirements.txt"):
        path = root / name
        if path.is_file():
            newest = max(newest, path.stat().st_mtime)
    return newest

stale = "no"
source_dir = str(state.get("source_dir") or "")
installed_at = state.get("installed_at") or ""
if source_dir and installed_at and os.path.isdir(source_dir):
    try:
        installed_ts = datetime.fromisoformat(installed_at).timestamp()
        if newest_source_mtime(pathlib.Path(source_dir)) > installed_ts + 1:
            stale = "yes"
    except ValueError:
        pass

commit = str(state.get("commit") or "")
if commit and state.get("dirty"):
    commit += "+"

fields = [
    ("VC_VERSION", str(state.get("version") or fallback_version or "unknown")),
    ("VC_COMMIT", commit),
    ("VC_INSTALLED", pretty(installed_at)),
    ("VC_UPDATED", pretty(state.get("source_updated_at") or "")),
    ("VC_PREV_VERSION", str(state.get("previous_version") or "")),
    ("VC_SOURCE_DIR", source_dir),
    ("VC_STALE", stale),
]
for key, value in fields:
    print(f"{key}={shlex.quote(value)}")
PY
}

SEATS_OVERRIDE=""
SEATS_SOURCE=""
SEATS_IGNORED=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    -s|--seats)
      if [[ -n "${2:-}" && ( "${2}" != -* || "${2}" =~ ^-[0-9] ) ]]; then
        SEATS_OVERRIDE="$2"
        shift 2
      else
        SEATS_OVERRIDE="(none given)"
        shift
      fi
      SEATS_SOURCE="--seats"
      ;;
    -h|--help)
      show_help
      exit 0
      ;;
    -v|--version)
      show_version
      exit 0
      ;;
    --)
      shift
      break
      ;;
    *)
      echo "Unknown option: $1" >&2
      echo "Try: vlc-control --help" >&2
      exit 2
      ;;
  esac
done

CONFIG_DIR="${VLC_CONTROL_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/vlc-control}"
CFG_TOML="$CONFIG_DIR/config.toml"

if [[ ! -f "$CFG_TOML" ]]; then
  echo "[x] No config file at $CFG_TOML" >&2
  echo "    Run install.sh to create one, then try again." >&2
  exit 1
fi

_config_output="$(_read_system_config "$CFG_TOML")" || {
  echo "[x] Couldn't read $CFG_TOML" >&2
  echo "    The error above says what's wrong with it. Re-running install.sh will rebuild it if you get stuck." >&2
  exit 1
}
eval "$_config_output"

: "${PORT:?Missing port in config.toml [system]}"
: "${VLC_HOST:?Missing vlc_host in config.toml [system]}"
: "${VLC_PORT:?Missing vlc_port in config.toml [system]}"
mkdir -p "${LOG_DIR}"
LOG_DIR="$(cd "${LOG_DIR}" && pwd)"

: > "${LOG_DIR}/vlc-bridge.log"
: > "${LOG_DIR}/vlc-http.log"
: > "${LOG_DIR}/vlc-cloudflared.log"

if [[ -n "${VLC_CONTROL_SEATS:-}" && -z "$SEATS_OVERRIDE" ]]; then
  SEATS_OVERRIDE="$VLC_CONTROL_SEATS"
  SEATS_SOURCE="VLC_CONTROL_SEATS"
fi

if [[ -n "$SEATS_OVERRIDE" ]]; then
  if [[ "$SEATS_OVERRIDE" =~ ^[0-9]+$ ]] && (( SEATS_OVERRIDE >= 1 && SEATS_OVERRIDE <= 99 )); then
    MAX_CLIENTS="$SEATS_OVERRIDE"
  else
    SEATS_IGNORED="$SEATS_OVERRIDE"
  fi
fi

TOKEN="$(python3 - <<'PY'
import secrets
print(secrets.token_urlsafe(24))
PY
)"
export TOKEN

export VLC_CONTROL_CONFIG_DIR="$CONFIG_DIR"

VLC_URL="http://${VLC_HOST}:${VLC_PORT}"
export VLC_URL VLC_PASS MAX_CLIENTS GRACE_SECONDS PORT LOG_DIR

PIDFILE="${LOG_DIR}/vlc-control-bridge.pid"

_status_has() {
  [[ ",${STATUS_SHOW:-}," == *",$1,"* ]]
}

_console_gap_done=""

console_gap() {
  if [[ -z "$_console_gap_done" ]]; then
    echo
    _console_gap_done=1
  fi
}

step() {
  if _status_has steps; then
    console_gap
    printf '%s\n' "$*"
  fi
}

warn() {
  console_gap >&2
  printf '%s\n' "$*" >&2
}

print_status_banner() {
  [[ -n "${STATUS_SHOW:-}" ]] || return 0

  local state_output
  state_output="$(_read_install_state "${PREFIX}/install-state.json" "$APP_VERSION" 2>/dev/null)" || return 0
  eval "$state_output"

  echo
  if _status_has version; then
    if [[ -n "$VC_COMMIT" ]]; then
      echo "vlc-control ${VC_VERSION} (${VC_COMMIT})"
    else
      echo "vlc-control ${VC_VERSION}"
    fi
  fi
  if _status_has installed && [[ -n "$VC_INSTALLED" ]]; then
    if [[ -n "$VC_PREV_VERSION" && "$VC_PREV_VERSION" != "$VC_VERSION" ]]; then
      echo "Installed:  ${VC_INSTALLED}, upgraded from ${VC_PREV_VERSION}"
    else
      echo "Installed:  ${VC_INSTALLED}"
    fi
  fi
  if _status_has updated && [[ -n "$VC_UPDATED" ]]; then
    echo "Updated:    ${VC_UPDATED}"
  fi
  if _status_has stale && [[ "$VC_STALE" == "yes" ]]; then
    echo "[!] The source has changed since this copy was installed - re-run install.sh to pick the changes up."
  fi
  if _status_has paths; then
    echo "Install:    ${PREFIX}"
    if [[ -n "$VC_SOURCE_DIR" ]]; then
      echo "Source:     ${VC_SOURCE_DIR}"
    fi
  fi
  if _status_has seats; then
    if [[ "${GRACE_SECONDS}" == "0" ]]; then
      echo "Seats:      ${MAX_CLIENTS} (no grace)"
    else
      echo "Seats:      ${MAX_CLIENTS} (${GRACE_SECONDS}s grace)"
    fi
  fi
  if _status_has runtime; then
    local python_bin="$PREFIX/.venv/bin/python"
    [[ -x "$python_bin" ]] || python_bin="python3"
    local runtime_line
    runtime_line="$("$python_bin" -V 2>&1 | head -n 1)"
    if command -v cloudflared >/dev/null 2>&1; then
      local cf_version
      cf_version="$(cloudflared --version 2>/dev/null | head -n 1 | cut -d' ' -f3)"
      if [[ -n "$cf_version" ]]; then
        runtime_line="${runtime_line}, cloudflared ${cf_version}"
      fi
    fi
    echo "Runtime:    ${runtime_line}"
  fi
}

if [[ -n "$SEATS_IGNORED" ]]; then
  if [[ "$SEATS_IGNORED" == "(none given)" ]]; then
    warn "[!] ${SEATS_SOURCE} needs a whole number from 1 to 99 after it."
  else
    warn "[!] ${SEATS_SOURCE} was set to \"${SEATS_IGNORED}\", which isn't a whole number from 1 to 99."
  fi
  warn "    Ignoring it and using max_clients = ${MAX_CLIENTS} from ${CFG_TOML}."
fi

print_status_banner

echo
if _status_has token; then
  echo "Token:      $TOKEN"
fi
echo "Local URL:  http://127.0.0.1:${PORT}/?t=${TOKEN}"

vlc_mode_available() {
  case "$1" in
    flatpak) command -v flatpak >/dev/null 2>&1 && flatpak info org.videolan.VLC >/dev/null 2>&1 ;;
    native)  command -v vlc >/dev/null 2>&1 ;;
    *) return 1 ;;
  esac
}

auto_detect_vlc_mode() {
  vlc_mode_available flatpak && { echo "flatpak"; return; }
  vlc_mode_available native && { echo "native"; return; }
  echo "none"
}

VLC_CFG_CANDIDATES=(
  "${HOME}/.config/vlc/vlcrc"
  "${HOME}/.var/app/org.videolan.VLC/config/vlc/vlcrc"
)

vlc_cfg_label() {
  case "$1" in
    *"/.var/app/org.videolan.VLC/"*) echo "flatpak" ;;
    *) echo "native" ;;
  esac
}

check_vlc_configs() {
  local cfg pass label
  for cfg in "${VLC_CFG_CANDIDATES[@]}"; do
    [[ -f "$cfg" ]] || continue
    label="$(vlc_cfg_label "$cfg")"
    pass="$(grep -E '^[[:space:]]*http-password=' "$cfg" | tail -n 1 | cut -d= -f2- || true)"
    if ! grep -qE '^[[:space:]]*extraintf=.*\bhttp\b' "$cfg"; then
      warn "[!] The ${label} VLC config has no HTTP interface enabled: ${cfg}"
    elif [[ "$pass" != "$VLC_PASS" ]]; then
      warn "[!] The ${label} VLC config has a different HTTP password to ${CFG_TOML}: ${cfg}"
    else
      continue
    fi
    warn "    If you start ${label} VLC yourself, this won't be able to reach it. Re-run install.sh to fix that."
  done
}

resolved_vlc_mode="$VLC_MODE"
if [[ "$resolved_vlc_mode" == "auto" || -z "$resolved_vlc_mode" ]]; then
  resolved_vlc_mode="$(auto_detect_vlc_mode)"
elif [[ "$resolved_vlc_mode" != "none" ]] && ! vlc_mode_available "$resolved_vlc_mode"; then
  warn "[!] vlc_mode = \"${resolved_vlc_mode}\" in ${CFG_TOML}, but no ${resolved_vlc_mode} VLC is installed."
  installed_vlc_mode="$(auto_detect_vlc_mode)"
  if [[ "$installed_vlc_mode" != "none" ]]; then
    warn "    You have the ${installed_vlc_mode} one - set vlc_mode = \"${installed_vlc_mode}\" (or \"auto\") to use it."
  fi
  resolved_vlc_mode="none"
fi

vlc_port_open() {
  if command -v ss >/dev/null 2>&1; then
    ss -ltn 2>/dev/null | grep -qE "[[:space:]]${VLC_HOST//./\.}:${VLC_PORT}[[:space:]]" && return 0
    ss -ltn 2>/dev/null | grep -qE "[:\]]${VLC_PORT}[[:space:]]" && return 0
    return 1
  fi
  (exec 3<>"/dev/tcp/${VLC_HOST}/${VLC_PORT}") >/dev/null 2>&1 && { exec 3<&- 3>&-; return 0; }
  return 1
}

vlc_http_auth_ok() {
  command -v curl >/dev/null 2>&1 || return 1
  curl -fsS --max-time 1 -u ":${VLC_PASS}" "${VLC_URL}/requests/status.json" >/dev/null 2>&1
}

start_vlc_if_needed() {
  if vlc_port_open; then
    if vlc_http_auth_ok; then
      step "[*] Using the VLC already running at ${VLC_URL}."
    else
      warn "[x] Something is already listening at ${VLC_URL}, but it rejected the password."
      warn "    Set vlc_pass in ${CFG_TOML} to match VLC's HTTP password, or start VLC with the password from there."
      warn "    Nothing was started, in case that is a VLC you are already using. Stopping."
      exit 1
    fi
    return 0
  fi

  if [[ "${START_VLC}" != "yes" ]]; then
    warn "[!] VLC isn't running, and start_vlc = false in ${CFG_TOML}."
    warn "    Start VLC yourself whenever you like - this will connect to it on its own."
    return 1
  fi

  if [[ "$resolved_vlc_mode" == "none" ]]; then
    warn "[!] No VLC installation found, so none was started."
    warn "    Install VLC or start it yourself - this will connect to it on its own."
    return 1
  fi

  step "[*] Starting VLC (${resolved_vlc_mode}) with HTTP control..."
  local vlc_cmd=()
  if [[ "$resolved_vlc_mode" == "flatpak" ]]; then
    vlc_cmd=(flatpak run org.videolan.VLC)
  else
    vlc_cmd=(vlc)
  fi
  vlc_cmd+=(--extraintf http --http-host "${VLC_HOST}" --http-port "${VLC_PORT}" --http-password "${VLC_PASS}")

  if [[ "${KILL_VLC_ON_EXIT}" == "yes" ]]; then
    "${vlc_cmd[@]}" >"${LOG_DIR}/vlc-http.log" 2>&1 &
    VLC_PID=$!
    step "[*] VLC started (PID ${VLC_PID}) - it will be closed when you stop this."
  else
    if command -v setsid >/dev/null 2>&1; then
      setsid "${vlc_cmd[@]}" >"${LOG_DIR}/vlc-http.log" 2>&1 < /dev/null &
    else
      "${vlc_cmd[@]}" >"${LOG_DIR}/vlc-http.log" 2>&1 < /dev/null &
      disown || true
    fi
    step "[*] VLC started detached - it will keep running after this stops (kill_vlc_on_exit = false)."
  fi

  for _ in {1..30}; do
    vlc_port_open && break
    sleep 0.2
  done

  if vlc_port_open; then
    step "[*] VLC is up and answering on port ${VLC_PORT}."
  else
    warn "[!] VLC didn't start listening on port ${VLC_PORT}. See ${LOG_DIR}/vlc-http.log"
    warn "    Carrying on - if VLC comes up later, this will connect to it on its own."
    return 1
  fi
}

stop_existing_bridge() {
  if [[ -f "$PIDFILE" ]]; then
    local old_pid
    old_pid="$(cat "$PIDFILE" 2>/dev/null || true)"
    if [[ -n "${old_pid}" ]] && kill -0 "${old_pid}" >/dev/null 2>&1; then
      step "[*] Stopping the bridge left over from the last run (PID ${old_pid})..."
      kill "${old_pid}" >/dev/null 2>&1 || true
      for _ in {1..40}; do
        kill -0 "${old_pid}" >/dev/null 2>&1 || break
        sleep 0.1
      done
    fi
    rm -f "$PIDFILE" || true
  fi
}

start_bridge() {
  stop_existing_bridge

  cd "$PREFIX"
  # shellcheck disable=SC1090
  source "$PREFIX/.venv/bin/activate"

  : > "${LOG_DIR}/vlc-bridge.log"
  python "$PREFIX/vlc-bridge.py" >>"${LOG_DIR}/vlc-bridge.log" 2>&1 &
  BRIDGE_PID=$!
  echo "$BRIDGE_PID" > "$PIDFILE" || true

  local origin="http://127.0.0.1:${PORT}"
  for _ in {1..80}; do
    if command -v curl >/dev/null 2>&1; then
      if curl -4 -fsS --max-time 1 "${origin}/api/clients?t=${TOKEN}&cid=probe" >/dev/null 2>&1; then
        break
      fi
    else
      break
    fi
    sleep 0.1
  done

  deactivate || true
  step "[*] Bridge started (PID ${BRIDGE_PID})."
}

CF_LAUNCH_STATE=""

launch_cloudflared() {
  case "${CLOUDFLARE}" in
    off) CF_LAUNCH_STATE="off"; return 0 ;;
    on|auto) ;;
    *) CF_LAUNCH_STATE="bad_mode"; return 0 ;;
  esac

  if ! command -v cloudflared >/dev/null 2>&1; then
    CF_LAUNCH_STATE="missing"
    return 0
  fi

  ORIGIN_URL="http://127.0.0.1:${PORT}"
  cloudflared tunnel --no-autoupdate --url "${ORIGIN_URL}" >>"${LOG_DIR}/vlc-cloudflared.log" 2>&1 &
  CF_PID=$!
  CF_LAUNCH_STATE="started"
}

drop_tunnel() {
  [[ -n "${CF_PID:-}" ]] || return 0
  kill "$CF_PID" 2>/dev/null || true
  CF_PID=""
}

tunnel_failed() {
  if [[ "${CLOUDFLARE}" == "on" ]]; then
    warn "[x] Stopping, because cloudflare = \"on\" in ${CFG_TOML} asks for a share link."
    warn "    Set it to \"auto\" if you would rather keep going without one."
    exit 1
  fi
  warn "    Carrying on without a share link."
  return 0
}

check_bridge_alive() {
  command -v curl >/dev/null 2>&1 || return 0

  local origin="http://127.0.0.1:${PORT}"
  if ! curl -4 -fsS --max-time 1 "${origin}/" >/dev/null 2>&1; then
    warn "[x] The bridge never came up at ${origin} - aborting."
    warn "    See ${LOG_DIR}/vlc-bridge.log"
    drop_tunnel
    exit 1
  fi

  local probe="${origin}/api/clients?t=${TOKEN}&cid=probe"
  if ! curl -4 -fsS --max-time 1 "$probe" >/dev/null 2>&1; then
    local code
    code="$(curl -4 -s -o /dev/null -w "%{http_code}" --max-time 1 "$probe" || true)"
    warn "[x] The bridge turned down this run's own access token (HTTP ${code}), so nobody could get in. Stopping."
    warn "    See ${LOG_DIR}/vlc-bridge.log"
    drop_tunnel
    exit 1
  fi
}

start_cloudflared() {
  case "$CF_LAUNCH_STATE" in
    off) step "[*] Sharing is off (cloudflare = \"off\") - local network only."; return 0 ;;
    bad_mode)
      warn "[!] cloudflare = \"${CLOUDFLARE}\" isn't a valid setting in ${CFG_TOML}. Use \"auto\", \"on\" or \"off\"."
      warn "    Carrying on without a share link. The local URL above still works on the local network."
      return 0
      ;;
    missing)
      if [[ "${CLOUDFLARE}" == "on" ]]; then
        warn "[!] cloudflare = \"on\", but cloudflared isn't installed."
        tunnel_failed
        return 0
      fi
      step "[*] cloudflared isn't installed, so there's no share link - local network only."
      return 0
      ;;
  esac

  step "[*] Cloudflare tunnel started (PID ${CF_PID})."

  PUBLIC_URL=""
  local waited=0
  for _ in {1..80}; do
    PUBLIC_URL="$(grep -oE 'https://[a-z0-9-]+\.trycloudflare\.com' "${LOG_DIR}/vlc-cloudflared.log" | tail -n 1 || true)"
    [[ -n "$PUBLIC_URL" ]] && break
    waited=$((waited + 1))
    if (( waited == 1 )); then
      console_gap
      printf '[*] Waiting for the tunnel URL'
    fi
    if (( waited % 5 == 0 )); then
      printf '.'
    fi
    sleep 0.2
  done
  if (( waited > 0 )); then
    printf '\n'
  fi

  if [[ -n "$PUBLIC_URL" ]]; then
    SHARE_URL="${PUBLIC_URL}/?t=${TOKEN}"
    echo
    echo "==================== SHARE LINK ===================="
    echo "$SHARE_URL"
    echo "===================================================="

    if command -v wl-copy >/dev/null 2>&1; then
      printf '%s' "$SHARE_URL" | wl-copy
      step "(Copied to your clipboard)"
    elif command -v xclip >/dev/null 2>&1; then
      printf '%s' "$SHARE_URL" | xclip -selection clipboard
      step "(Copied to your clipboard)"
    fi
  else
    warn "[!] The tunnel started but never gave us a link. Last 15 lines of ${LOG_DIR}/vlc-cloudflared.log:"
    tail -n 15 "${LOG_DIR}/vlc-cloudflared.log" >&2 || true
    tunnel_failed
  fi
}

HOSTLOG_PIDFILE="${LOG_DIR}/vlc-control-hostlog.pid"

start_hostlog() {
  stop_hostlog

  local tail_cmd="tail -n +1 -F \"${LOG_DIR}/vlc-bridge.log\" 2>/dev/null | \"$PREFIX/.venv/bin/python\" \"$PREFIX/vlc-bridge.py\" --tail"

  if command -v setsid >/dev/null 2>&1; then
    setsid bash -c "$tail_cmd" &
    echo $! > "$HOSTLOG_PIDFILE"
  else
    ( bash -c "$tail_cmd" ) &
    echo $! > "$HOSTLOG_PIDFILE"
  fi
}

stop_hostlog() {
  if [[ -f "$HOSTLOG_PIDFILE" ]]; then
    local pgid
    pgid="$(cat "$HOSTLOG_PIDFILE" 2>/dev/null || true)"
    if [[ -n "$pgid" ]] && kill -0 "$pgid" >/dev/null 2>&1; then
      kill -TERM "-$pgid" 2>/dev/null || true
      sleep 0.1
      kill -KILL "-$pgid" 2>/dev/null || true
    fi
    rm -f "$HOSTLOG_PIDFILE" 2>/dev/null || true
  fi
}

cleanup() {
  trap - INT TERM EXIT
  echo
  echo "[*] Shutting down..."
  [[ -n "${CF_PID:-}" ]] && kill "$CF_PID" 2>/dev/null || true
  [[ -n "${BRIDGE_PID:-}" ]] && kill "$BRIDGE_PID" 2>/dev/null || true
  if [[ -n "${VLC_PID:-}" ]]; then
    echo "[*] Closing VLC (PID ${VLC_PID})..."
    kill "$VLC_PID" 2>/dev/null || true
  fi
  stop_hostlog
  exit 0
}
trap cleanup INT TERM EXIT

launch_cloudflared
start_vlc_if_needed || true
check_vlc_configs
start_bridge

check_bridge_alive
start_cloudflared

echo
echo "[OK] Running."
if _status_has ready; then
  echo "Config: ${CFG_TOML}"
  echo "Logs:"
  echo " - ${LOG_DIR}/vlc-bridge.log"
  echo " - ${LOG_DIR}/vlc-http.log"
  echo " - ${LOG_DIR}/vlc-cloudflared.log"
  if [[ -f "${LOG_DIR}/vlc-access.log" ]]; then
    echo " - ${LOG_DIR}/vlc-access.log"
  fi
fi
if _status_has logkey; then
  echo "Log key: + joined   - left   * action   ~ VLC   ! problem   x fatal"
fi
echo "Press Ctrl+C to stop."

